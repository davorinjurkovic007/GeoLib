<Window x:Class="GeoLib.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="554" Width="1000">
    <Grid Margin="0,0,0, 0">
        <Label Content="Zip Code:" Height="40" HorizontalAlignment="Left" Margin="53,42,0,0" Name="label1" VerticalAlignment="Top" FontSize="20" Width="103" />
        <TextBox Height="36" HorizontalAlignment="Left" Margin="156,46,0,0" Name="txtZipCode" VerticalAlignment="Top" Width="143" FontSize="20" />
        <Button Content="Get Info" Height="39" HorizontalAlignment="Left" Margin="156,103,0,0" x:Name="btnGetInfo" VerticalAlignment="Top" Width="100" Click="btnGetInfo_Click" FontSize="20" />
        <Label Content="" Height="38" HorizontalAlignment="Left" Margin="156,157,0,0" Name="lblCity" VerticalAlignment="Top" Width="255" FontSize="20" />
        <Label Content="" Height="35" HorizontalAlignment="Left" Margin="156,211,0,0" Name="lblState" VerticalAlignment="Top" Width="255" FontSize="20" />
        <Label Content="State:" Height="40" HorizontalAlignment="Left" Margin="444,42,0,0" x:Name="label1_Copy" VerticalAlignment="Top" FontSize="20" Width="103" />
        <TextBox Height="36" HorizontalAlignment="Left" Margin="508,46,0,0" x:Name="txtState" VerticalAlignment="Top" Width="142" FontSize="20" RenderTransformOrigin="0.126,0.487" />
        <Button Content="Get Zip Codes" Height="39" HorizontalAlignment="Left" Margin="496,103,0,0" x:Name="btnGetZipCodes" VerticalAlignment="Top" Width="144" Click="btnGetZipCodes_Click" FontSize="20" />
        <TextBox Height="36" HorizontalAlignment="Left" Margin="694,46,0,0" x:Name="txtRange" VerticalAlignment="Top" Width="142" FontSize="20" RenderTransformOrigin="0.126,0.487" />
        <Button Content="Get In Range" Height="39" HorizontalAlignment="Left" Margin="694,103,0,0" x:Name="btnGetInRange" VerticalAlignment="Top" Width="144"  FontSize="20" Click="btnGetInRange_Click" />
        <ListBox HorizontalAlignment="Left" Height="279" Margin="463,211,0,0" VerticalAlignment="Top" Width="232" Name="lstZips" FontSize="16">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ZipCode}" />
                        <TextBlock Text=" - " />
                        <TextBlock Text="{Binding City}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Label Content="Text to show:" Height="40" HorizontalAlignment="Left" Margin="53,340,0,0" x:Name="label1_Copy1" VerticalAlignment="Top" FontSize="20" Width="147" />
        <TextBox x:Name="txtMessage" HorizontalAlignment="Left" Height="32" Margin="65,385,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="359" FontSize="18"/>
        <Button Content="Make Call" Height="39" HorizontalAlignment="Left" Margin="311,422,0,0" x:Name="btnMakeCall" VerticalAlignment="Top" Width="100" Click="btnMakeCall_Click" FontSize="20" />
        <Button Content="Push" Height="39" HorizontalAlignment="Left" Margin="324,43,0,0" x:Name="btnPush" VerticalAlignment="Top" Width="100" Click="btnPush_Click" FontSize="20" />
        <Button Content="Update Batch" HorizontalAlignment="Left" Margin="765,211,0,0" x:Name="btnUpdateBatch" VerticalAlignment="Top" Width="126" Height="39" FontSize="20" Click="btnUpdateBatch_Click"/>
        <Button Content="Put Back" HorizontalAlignment="Left" Margin="766,325,0,0" x:Name="btnPutBack" VerticalAlignment="Top" Width="125" Height="35" FontSize="20" Click="btnPutBack_Click"/>
    </Grid>
</Window>
